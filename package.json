{
  "name": "speaktoall",
  "version": "0.1.3",
  "description": "Fale. Vira texto. Em qualquer lugar.",
  "main": "src/main/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^26.18.0",
    "gifenc": "^1.0.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "opencc-js": "^1.4.2",
    "uiohook-napi": "^1.5.5"
  },
  "author": "Lucas Trombini B",
  "repository": {
    "type": "git",
    "url": "https://github.com/LucasTrombiniBatista/SpeakToAll.git"
  },
  "build": {
    "appId": "com.lucastrombini.speaktoall",
    "productName": "SpeakToAll",
    "npmRebuild": false,
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "src/main/injector.ps1",
      "**/node_modules/uiohook-napi/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "shortcutName": "SpeakToAll",
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "LucasTrombiniBatista",
      "repo": "SpeakToAll",
      "releaseType": "release"
    }
  }
}
